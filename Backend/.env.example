# MailTrace Environment Configuration

# Database Connection (PostgreSQL 16)
# Async URL for FastAPI SQLAlchemy asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/mailtrace
# Synchronous URL for Alembic migrations and synchronous scripts
SYNC_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mailtrace

# JWT Security
SECRET_KEY=mailtrace_super_secret_jwt_key_2026_forensics_soc_platform
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# External Intelligence APIs
# AbuseIPDB API key for live IP reputation & VPN/Tor exit node checks
# Get free key from: https://www.abuseipdb.com/
ABUSEIPDB_API_KEY=

# MaxMind GeoLite2 City Database Path
# Default points to local database
MAXMIND_DB_PATH=backend/data/GeoLite2-City.mmdb

# Storage & ML Models
RAW_EML_STORAGE_DIR=backend/storage/raw_emls
ML_MODEL_PATH=backend/models/phishing_classifier.joblib

# CORS Configuration
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
